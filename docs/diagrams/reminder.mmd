flowchart TB
    DRAFT["Запрос и черновик"] --> COMPLETE{"Данные полны?"}
    COMPLETE -->|"Нет"| ASK["Уточнить тему, время, зону или повтор"]
    ASK --> DRAFT
    COMPLETE -->|"Да"| PREVIEW["Показать точное расписание"]
    PREVIEW -->|"Подтверждение"| COMMIT["Сохранить reminder и ответ одной транзакцией"]
    COMMIT --> DUE["Worker выбирает наступившее событие"]
    DUE --> JOB["Создать delivery и пересчитать next_run_at"]
    JOB --> SEND["Проверить отмену и отправить"]
    SEND --> OK{"Успешно?"}
    OK -->|"Да"| SENT["Сохранить sent и message_id"]
    OK -->|"Нет"| RETRY["Повтор или постоянная ошибка"]
    RETRY --> SEND
