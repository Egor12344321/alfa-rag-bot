# Required for Telegram and answer generation.
BOT_TOKEN=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
LLM_TIMEOUT=60
LLM_MAX_TOKENS=4000
LLM_RETRIES=2

# Dedicated working DB. Compose constructs db:5432 from these fields.
POSTGRES_DB=alfa_bot
POSTGRES_USER=alfa_bot
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5433
# Used when running Python on Windows/Linux outside Compose.
DATABASE_URL=postgresql+psycopg://alfa_bot:change_me@localhost:5433/alfa_bot

# Must match the included prepared/manifest.json exactly.
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIMENSION=1024
EMBEDDING_DEVICE=cpu
EMBEDDING_THREADS=4
EMBEDDING_BATCH_SIZE=8
HF_HUB_OFFLINE=0
SCORE_THRESHOLD=0.6
RECOMMENDATION_LIMIT=1
HISTORY_LIMIT=10
DEFAULT_TIMEZONE=Europe/Moscow
REMINDER_INTERVAL=15
DRAFT_TTL_MINUTES=30
LOG_LEVEL=INFO

# Optional: only for importing a different source DB with a reviewed mapping.
SOURCE_DATABASE_URL=
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
