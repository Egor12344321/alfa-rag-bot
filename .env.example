BOT_TOKEN=

# Compose подставляет свой адрес db:5432. Строка ниже нужна для запуска с хоста.
DATABASE_URL=postgresql+asyncpg://alfa_bot:replace_me@127.0.0.1:5433/alfa_bot
# Необязательный пароль локального Compose PostgreSQL. Используйте URL-safe символы.
POSTGRES_PASSWORD=

# Оставьте оба поля пустыми для синтетического демо.
# SOURCE_DATABASE_URL указывает на отдельную БД с восстановленным дампом.
SOURCE_DATABASE_URL=
# Путь внутри Compose, например /app/private_data/materials.jsonl.
KB_MATERIALS_PATH=

KNOWLEDGE_BACKEND=pgvector
# Compose подставляет http://ollama:11434.
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b
LLM_TIMEOUT=180
OLLAMA_CONTEXT_LENGTH=8192
OLLAMA_MAX_LOADED_MODELS=1
EMBEDDING_MODEL=bge-m3:567m
EMBEDDING_TIMEOUT=180
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=50
KB_SCORE_THRESHOLD=0.6
KB_CATALOG_SCORE_THRESHOLD=0.55
KB_TOP_K=5
LOG_LEVEL=INFO
REMINDER_INTERVAL=15

ARTICLE_URL_TEMPLATE=https://kurs.alfabank.ru/articles/{slug}/
DOCUMENT_URL_TEMPLATE=https://kurs.alfabank.ru/documents/{slug}/
GLOSSARY_URL_TEMPLATE=https://kurs.alfabank.ru/vocabulary/{slug}/
COURSE_URL_TEMPLATE=https://kurs.alfabank.ru/courses/{slug}/
