# Только локальные демонстрационные значения. Скопировать в .env.
APP_ENV=local
LOG_LEVEL=INFO
DEFAULT_TIMEZONE=Europe/Moscow
POSTGRES_DB=assistant_db
POSTGRES_USER=alfa
POSTGRES_PASSWORD=alfa_local_only
POSTGRES_PORT=5432
API_PORT=8000
# URL для запуска Python НА ХОСТЕ. Compose сам заменяет host на db.
DATABASE_URL=postgresql+psycopg://alfa:alfa_local_only@localhost:5432/assistant_db
# Заполняет только владелец ingest. Runtime-контейнеры эту переменную не получают.
SOURCE_DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
LLM_PROVIDER=unconfigured
LLM_MODEL=
LLM_API_KEY=
EMBEDDING_MODEL=intfloat/multilingual-e5-small
